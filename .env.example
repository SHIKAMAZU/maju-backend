# Port server backend
PORT=3000

# Opsi 1: satu URL database (paling mudah)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pawcare_db

# Opsi 2: dipakai kalau DATABASE_URL kosong
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pawcare_db

# JWT
JWT_SECRET=isi_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Cloudinary (ambil dari dashboard Cloudinary)
CLOUDINARY_CLOUD_NAME=isi_cloud_name
CLOUDINARY_API_KEY=isi_api_key
CLOUDINARY_API_SECRET=isi_api_secret
